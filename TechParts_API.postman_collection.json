						"body": {
							"mode": "raw",
							"raw": "{\n    \"nombre\": \"Memoria RAM Kingston Fury 16GB DDR4\",\n    \"categoria\": \"Memoria RAM\",\n    \"precio\": 42990,\n    \"stock\": 12\n}"
