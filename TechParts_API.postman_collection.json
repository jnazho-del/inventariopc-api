{
	"info": {
		"_postman_id": "techparts-api-rest",
		"name": "TechParts - API RESTful",
		"description": "Colección de pruebas para la API REST de TechParts con Django REST Framework. Incluye operaciones CRUD, gestión de imágenes, casos de validación y autenticación por Token y JWT.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "01 - Autenticación y Usuarios",
			"item": [
				{
					"name": "1. Registrar Nuevo Usuario (POST)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"vendedor_tech\",\n    \"email\": \"vendedor@techparts.cl\",\n    \"password\": \"techparts2026\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/registro/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"registro",
								""
							]
						},
						"description": "Registra un usuario y devuelve su Auth Token directamente."
					},
					"response": []
				},
				{
					"name": "2. Obtener Auth Token DRF (POST)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"juan\",\n    \"password\": \"admin123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/token/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"token",
								""
							]
						},
						"description": "Obtiene el Token de autenticación de Django REST Framework."
					},
					"response": []
				},
				{
					"name": "3. Obtener Token JWT (POST)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"juan\",\n    \"password\": \"admin123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/jwt/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"jwt",
								""
							]
						},
						"description": "Obtiene tokens JWT de Acceso y Refresco (Unidad 3)."
					},
					"response": []
				},
				{
					"name": "4. Refrescar Token JWT (POST)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"refresh\": \"<PEGA_AQUI_TU_REFRESH_TOKEN>\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/jwt/refresh/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"jwt",
								"refresh",
								""
							]
						},
						"description": "Renueva el token de acceso JWT."
					},
					"response": []
				}
			]
		},
