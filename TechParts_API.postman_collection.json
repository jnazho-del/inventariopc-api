						"body": {
							"mode": "raw",
							"raw": "{\n    \"nombre\": \"tarjeta de video rtx 3060ti OC Edition\",\n    \"categoria\": \"tarjeta de video\",\n    \"precio\": 115000,\n    \"stock\": 5\n}"
