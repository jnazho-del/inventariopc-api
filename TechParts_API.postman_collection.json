								"value": "Token {{auth_token}}",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"stock\": 10,\n    \"precio\": 99990\n}"
						},
						"url": {
							"raw": "{{base_url}}/repuestos/2/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"repuestos",
								"2",
								""
							]
